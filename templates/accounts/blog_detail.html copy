{% extends 'accounts/base.html' %}

{% block content %}
  <div class="blog-post">
    <h1>{{ blog.title }}</h1>
    <p>By {{ blog.author }} | {{ blog.created_at }}</p>
    <img src="{{ blog.cover_image }}" alt="{{ blog.title }}" />
    <div class="blog-content">
      {{ blog.content|safe }}
    </div>
    <p>Views: {{ blog.views }}</p>
    <p>Tags: 
      {% for tag in blog.tags.all %}
        {{ tag.name }}
      {% endfor %}
    </p>
    <p>Category: {{ blog.category }}</p>
  </div>
{% endblock %}
